# ─────────────────────────────────────────────────────────────
# Studio 61 — Analytics — environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string (use the POOLED connection string).
# This app uses its OWN database — separate from the other Studio 61 apps.
# It stores ONLY accounts + site config; raw events live in Cloudflare
# Analytics Engine. Dashboard: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js (NextAuth v5) session-encryption secret. REQUIRED.
# This is per-app (do NOT reuse another app's value).
# Generate one with:  npx auth secret   (or)   openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app. Used for auth callbacks. No trailing slash.
#   local:      http://localhost:3000
#   production: https://insights.studiosixty-one.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── CRM SSO (token handoff) ───────────────────────────────────────────────────
# Shared HMAC secret for verifying SSO handoff tokens minted by the CRM.
# Must be IDENTICAL across the CRM and every Studio 61 app. Generate:
#   openssl rand -base64 32
SSO_SHARED_SECRET=""

# CRM portal URL — used for a "Return to portal" link on the sign-in page.
CRM_PORTAL_URL="https://client.studiosixty-one.com"

# ── Cloudflare Analytics Engine (the event store) ─────────────────────────────
# Used to query analytics via the SQL API. Create an API token with the
# "Account Analytics: Read" permission. Account id is on the Cloudflare
# dashboard home (right sidebar).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Public base URL of the edge collector Worker (serves /script.js and receives
# events). Embedded in the customer tracking snippet. No trailing slash.
#   local:      http://localhost:8787        (wrangler dev)
#   production: https://collector.<acct>.workers.dev  (or a custom subdomain)
NEXT_PUBLIC_COLLECTOR_URL="http://localhost:8787"

# Secret protecting the daily rollup cron (/api/cron/rollup). Generate with
# `openssl rand -base64 32`. On Vercel, set this and Cron sends it automatically.
CRON_SECRET=""
